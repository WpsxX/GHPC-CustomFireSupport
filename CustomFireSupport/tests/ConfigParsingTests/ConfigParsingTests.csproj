<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the pure config-parsing logic outside the game. SlotConfigParsing.cs is compiled in directly
    (it deliberately has no MelonLoader / Unity dependencies), so this project needs nothing else.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ConfigParsingTests</AssemblyName>
    <RootNamespace>ConfigParsingTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\SlotConfigParsing.cs" Link="SlotConfigParsing.cs" />
    <Compile Include="..\..\CfgSectionParser.cs" Link="CfgSectionParser.cs" />
    <Compile Include="..\..\CasAirframeCatalog.cs" Link="CasAirframeCatalog.cs" />
    <Compile Include="..\..\FactionShellCatalog.cs" Link="FactionShellCatalog.cs" />
    <Compile Include="..\..\FactionBatteryProfiles.cs" Link="FactionBatteryProfiles.cs" />
    <Compile Include="..\..\ArtilleryTiming.cs" Link="ArtilleryTiming.cs" />
    <Compile Include="..\..\DefaultConfigSection.cs" Link="DefaultConfigSection.cs" />
  </ItemGroup>

</Project>
